print('transactions:', transactions.shape)
print('products    :', products.shape)
print('campaigns   :', campaigns.shape)


#基础信息--看规模、缺失、重复
def basic_info(df, name):
    print(f'===== {name} =====')
    print(f'形状: {df.shape}')
    print(f'字段: {list(df.columns)}')
    missing = df.isnull().sum()
    missing = missing[missing > 0]
    if len(missing) > 0:
        print(f'缺失值:\n{missing}')
    else:
        print('无缺失值')
    print(f'重复行: {df.duplicated().sum()}')
    print('-' * 60)

for df, name in [(customers, 'customers'), (events, 'events'),
                 (transactions, 'transactions'), (products, 'products'),
                 (campaigns, 'campaigns')]:
    basic_info(df, name)


#前几行--确认字段内容
for df, name in [(customers, 'customers'), (events, 'events'),
                 (transactions, 'transactions'), (products, 'products'),
                 (campaigns, 'campaigns')]:
    print(f'===== {name} 前3行 =====')
    display(df.head(3))
    print()


#事件分布--决定漏斗怎么建
event_dist = events['event_type'].value_counts()
print(event_dist)
print('\n占比(%):')
