plt.figure(figsize=(8, 5))
event_dist.plot(kind='bar', color='steelblue')
plt.title('Event Type Distribution')
plt.ylabel('Count')
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()


#用户属性分布
fig, axes = plt.subplots(2, 2, figsize=(13, 9))

customers['acquisition_channel'].value_counts().plot(kind='bar', ax=axes[0,0], title='Acquisition Channel', color='steelblue')
customers['loyalty_tier'].value_counts().plot(kind='bar', ax=axes[0,1], title='Loyalty Tier', color='coral')
