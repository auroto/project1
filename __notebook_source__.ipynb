#数据加载--读取五张表
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import os

DATA_DIR = '/kaggle/input/datasets/geethasagarbonthu/marketing-and-e-commerce-analytics-dataset'

customers    = pd.read_csv(f'{DATA_DIR}/customers.csv')
events       = pd.read_csv(f'{DATA_DIR}/events.csv')
transactions = pd.read_csv(f'{DATA_DIR}/transactions.csv')
products     = pd.read_csv(f'{DATA_DIR}/products.csv')
campaigns    = pd.read_csv(f'{DATA_DIR}/campaigns.csv')

print('加载完成')
print('customers   :', customers.shape)
