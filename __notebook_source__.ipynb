customers['age'].hist(bins=20, ax=axes[1,1], color='mediumpurple')
axes[1,1].set_title('Age Distribution')

plt.tight_layout()
plt.show()

print('国家分布:')
print(customers['country'].value_counts())


# 过滤退款记录，只保留正向交易
transactions_valid = transactions[transactions['refund_flag'] == 0].copy()

fig, axes = plt.subplots(1, 3, figsize=(16, 5))

products['category'].value_counts().plot(kind='bar', ax=axes[0], title='Product Category', color='steelblue')

transactions_valid['gross_revenue'].hist(bins=30, ax=axes[1], color='coral')
axes[1].set_title('Gross Revenue Distribution (Refund Excluded)')

transactions_valid['discount_applied'].hist(bins=20, ax=axes[2], color='seagreen')
axes[2].set_title('Discount Rate Distribution')

plt.tight_layout()
plt.show()

print('=== 交易金额描述（剔除退款） ===')
print(transactions_valid['gross_revenue'].describe().round(2))
print('\n=== 折扣率描述 ===')
print(transactions_valid['discount_applied'].describe().round(4))
print('\n=== 折扣率取值分布 ===')
print(transactions_valid['discount_applied'].value_counts().sort_index())
print('\n=== 有折扣订单占比 ===')
print(f"{(transactions_valid['discount_applied'] > 0).mean():.2%}")
print('\n=== 高端商品占比 ===')
print(products['is_premium'].value_counts(normalize=True).round(4))


#外检完整性检查
orphan_events_cust = events[~events['customer_id'].isin(customers['customer_id'])]
print(f'events 中孤儿 customer_id 数量: {len(orphan_events_cust)}')

events_prod = events.dropna(subset=['product_id'])
orphan_events_prod = events_prod[~events_prod['product_id'].isin(products['product_id'])]
print(f'events 中孤儿 product_id 数量: {len(orphan_events_prod)}')

orphan_tx_cust = transactions[~transactions['customer_id'].isin(customers['customer_id'])]
print(f'transactions 中孤儿 customer_id 数量: {len(orphan_tx_cust)}')

orphan_tx_prod = transactions[~transactions['product_id'].isin(products['product_id'])]
print(f'transactions 中孤儿 product_id 数量: {len(orphan_tx_prod)}')

events['timestamp'] = pd.to_datetime(events['timestamp'])
transactions['timestamp'] = pd.to_datetime(transactions['timestamp'])
print(f'\nevents 时间范围: {events.timestamp.min()} ~ {events.timestamp.max()}')
print(f'transactions 时间范围: {transactions.timestamp.min()} ~ {transactions.timestamp.max()}')


#探索关键字段分布
print('=== experiment_group 分布 ===')
print(events['experiment_group'].value_counts(dropna=False))
print('\n=== traffic_source 分布 ===')
print(events['traffic_source'].value_counts(dropna=False))
print('\n=== device_type 分布 ===')
print(events['device_type'].value_counts(dropna=False))
print('\n=== page_category 分布 ===')
print(events['page_category'].value_counts(dropna=False))


#确认缺失值业务逻辑
# product_id 缺失的事件是什么类型？
print('product_id 缺失的事件类型分布:')
print(events[events['product_id'].isnull()]['event_type'].value_counts())

# device_type 缺失的事件类型分布
print('\ndevice_type 缺失的事件类型分布:')
print(events[events['device_type'].isnull()]['event_type'].value_counts())

# transactions 里 product_id 缺失的记录，refund_flag 是什么？
print('\ntransactions 中 product_id 缺失记录的 refund_flag 分布:')
print(transactions[transactions['product_id'].isnull()]['refund_flag'].value_counts())

# transactions 里 refund_flag 整体分布
print('\ntransactions refund_flag 整体分布:')
print(transactions['refund_flag'].value_counts())


#清洗--数据质量处理
# 统一 traffic_source 大小写
print('清洗前:')
print(events['traffic_source'].value_counts())

events['traffic_source'] = events['traffic_source'].str.strip().str.title()
# Title() 会把 "PAID SEARCH" → "Paid Search"，"ORGANIC" → "Organic"

print('\n清洗后:')
print(events['traffic_source'].value_counts())


#会话级漏斗
# 方案：按 session_id 构建会话级漏斗
# 一个会话里，只要有对应事件就算完成该步

session_funnel = events[events['event_type'] != 'bounce'].pivot_table(
    index='session_id',
    columns='event_type',
    values='event_id',
    aggfunc='count'
).fillna(0)

funnel_cols = ['view', 'click', 'add_to_cart', 'purchase']
session_funnel = session_funnel.reindex(columns=funnel_cols, fill_value=0)

for col in funnel_cols:
    session_funnel[f'has_{col}'] = (session_funnel[col] > 0).astype(int)

# 只保留从 view 开始的会话（有效漏斗起点）
session_funnel = session_funnel[session_funnel['has_view'] == 1]

funnel_result = {
    'total_sessions': len(session_funnel),
    'view_sessions': int(session_funnel['has_view'].sum()),
    'click_sessions': int(session_funnel['has_click'].sum()),
    'cart_sessions': int(session_funnel['has_add_to_cart'].sum()),
    'purchase_sessions': int(session_funnel['has_purchase'].sum()),
}
funnel_result['view_to_click'] = funnel_result['click_sessions'] / funnel_result['view_sessions']
funnel_result['click_to_cart'] = funnel_result['cart_sessions'] / funnel_result['click_sessions']
funnel_result['cart_to_purchase'] = funnel_result['purchase_sessions'] / funnel_result['cart_sessions']
funnel_result['view_to_purchase'] = funnel_result['purchase_sessions'] / funnel_result['view_sessions']

print(pd.Series(funnel_result).round(4))


#跨组诊断
# 1. 检查用户是否跨组
user_groups = events.groupby('customer_id')['experiment_group'].nunique()
print('跨组用户数量:', (user_groups > 1).sum())
print('只属于一组的用户:', (user_groups == 1).sum())
print('跨组用户占比:', round((user_groups > 1).mean(), 4))

# 2. 各组唯一用户数（去重后）
print('\n各组唯一用户数:')
print(events.groupby('experiment_group')['customer_id'].nunique())

# 3. 如果一个用户跨组，看他的购买行为怎么分布
multi_group_users = user_groups[user_groups > 1].index
sample_user = multi_group_users[0]
print(f'\n示例跨组用户 {sample_user} 的事件:')
print(events[events['customer_id'] == sample_user][['event_type', 'experiment_group', 'timestamp']].head(20))


#事件级
# 事件级转化率（唯一有效的方法）
event_ab = events.groupby(['experiment_group', 'event_type']).size().unstack(fill_value=0)

# 计算各组的漏斗转化率
event_ab['view_to_click'] = (event_ab['click'] / event_ab['view']).round(4)
event_ab['click_to_cart'] = (event_ab['add_to_cart'] / event_ab['click']).round(4)
event_ab['cart_to_purchase'] = (event_ab['purchase'] / event_ab['add_to_cart']).round(4)
event_ab['view_to_purchase'] = (event_ab['purchase'] / event_ab['view']).round(4)

print(event_ab[['view', 'click', 'add_to_cart', 'purchase',
                'view_to_click', 'click_to_cart', 'cart_to_purchase', 'view_to_purchase']])


#会话级（交叉验证）
# 每个会话的实验组（取该会话内第一次事件的组）
session_group = events.sort_values('timestamp').groupby('session_id')['experiment_group'].first().reset_index()

# 会话级漏斗
session_funnel = events[events['event_type'] != 'bounce'].pivot_table(
    index='session_id',
    columns='event_type',
    values='event_id',
    aggfunc='count'
).fillna(0)

funnel_cols = ['view', 'click', 'add_to_cart', 'purchase']
session_funnel = session_funnel.reindex(columns=funnel_cols, fill_value=0)
for col in funnel_cols:
    session_funnel[f'has_{col}'] = (session_funnel[col] > 0).astype(int)

# 只保留从 view 开始的会话
session_funnel = session_funnel[session_funnel['has_view'] == 1].reset_index()

# 合并实验组
session_funnel = session_funnel.merge(session_group, on='session_id', how='left')

# 按实验组计算会话级漏斗
ab_session = session_funnel.groupby('experiment_group').agg(
    sessions=('session_id', 'count'),
    view_sessions=('has_view', 'sum'),
    click_sessions=('has_click', 'sum'),
    cart_sessions=('has_add_to_cart', 'sum'),
    purchase_sessions=('has_purchase', 'sum')
).reset_index()

ab_session['view_to_click'] = (ab_session['click_sessions'] / ab_session['view_sessions']).round(4)
ab_session['click_to_cart'] = (ab_session['cart_sessions'] / ab_session['click_sessions']).round(4)
ab_session['cart_to_purchase'] = (ab_session['purchase_sessions'] / ab_session['cart_sessions']).round(4)
ab_session['view_to_purchase'] = (ab_session['purchase_sessions'] / ab_session['view_sessions']).round(4)

print(ab_session)


#渠道分析
# 清洗 traffic_source
events_clean = events.copy()
events_clean['traffic_source'] = events_clean['traffic_source'].str.strip().str.title()

# 每个用户第一次接触的渠道
user_source = events_clean.sort_values('timestamp').groupby('customer_id')['traffic_source'].first().reset_index()

# 用户级购买标记
user_purchase = events_clean.groupby('customer_id').agg(
    has_purchase=('event_type', lambda x: (x == 'purchase').any())
).reset_index()

# 合并
user_df = user_source.merge(user_purchase, on='customer_id', how='left')

# 渠道分析
source_funnel = user_df.groupby('traffic_source').agg(
    users=('customer_id', 'count'),
    purchasers=('has_purchase', 'sum')
).reset_index()
source_funnel['purchase_rate'] = (source_funnel['purchasers'] / source_funnel['users']).round(4)
source_funnel = source_funnel.sort_values('purchase_rate', ascending=False)

print(source_funnel)

plt.figure(figsize=(10, 5))
sns.barplot(data=source_funnel, x='traffic_source', y='purchase_rate', palette='Blues_d')
plt.title('Purchase Rate by Traffic Source')
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()


from scipy import stats

# 直接用现有的 session_funnel（它已经含 experiment_group 和 has_purchase）
contingency = pd.crosstab(
    session_funnel['experiment_group'],
    session_funnel['has_purchase']
)

chi2, p_value, dof, expected = stats.chi2_contingency(contingency)

print('=== 卡方检验（实验组 × 是否购买）===')
print(f'卡方统计量: {chi2:.2f}')
print(f'p_value: {p_value:.6f}')
print(f'自由度: {dof}')
print('\n列联表（观察值）:')
print(contingency)
print('\n期望频数:')
print(expected.round(2))

# 各组会话级购买率
print('\n=== 各组会话级购买率 ===')
purchase_rate = session_funnel.groupby('experiment_group')['has_purchase'].agg(['count', 'sum', 'mean'])
purchase_rate.columns = ['sessions', 'purchases', 'purchase_rate']
purchase_rate['purchase_rate'] = purchase_rate['purchase_rate'].round(4)
print(purchase_rate)


ab_session_plot = ab_session.set_index('experiment_group')[
    ['view_to_click', 'click_to_cart', 'cart_to_purchase', 'view_to_purchase']
]

ab_session_plot.plot(kind='bar', figsize=(10, 6), colormap='Set2')
plt.title('Funnel Conversion Rate by Experiment Group (Session-level)')
plt.ylabel('Conversion Rate')
plt.xticks(rotation=0)
plt.legend(loc='upper right')
plt.tight_layout()
plt.show()


